# ============================================================
# Database Configuration
# ============================================================
DB_URL=jdbc:postgresql://localhost:5432/osbp_db
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password_here

# ============================================================
# Security / JWT Configuration (Min 256-bit secret)
# ============================================================
JWT_SECRET=osbp-super-secret-key-change-me-in-production-must-be-at-least-256-bits
JWT_EXPIRATION_MS=86400000

# ============================================================
# Lucene Search Index Path
# ============================================================
# Optional: defaults to ~/osbp-lucene-index if not specified
# LUCENE_INDEX_PATH=C:/Users/daniel/osbp-lucene-index
